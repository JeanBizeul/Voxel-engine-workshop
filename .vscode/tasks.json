{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Hello-Triangle",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build",
                "-S",
                "${workspaceFolder}",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Hello-Triangle",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--target",
                "hello-triangle",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": ["CMake: Configure Hello-Triangle"]
        },
        {
            "label": "CMake: Clean Hello-Triangle",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Rebuild Hello-Triangle",
            "dependsOn": [
                "CMake: Clean Hello-Triangle",
                "CMake: Build Hello-Triangle"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run: Hello-Triangle",
            "type": "shell",
            "command": "${workspaceFolder}/build/Hello-Triangle/hello-triangle",
            "options": {
                "cwd": "${workspaceFolder}/Hello-Triangle"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": ["CMake: Build Hello-Triangle"]
        },
        {
            "label": "CMake: Build Hello-Triangle-Answer",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--target",
                "hello-triangle-answer",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": ["CMake: Configure Hello-Triangle"]
        },
        {
            "label": "Run: Hello-Triangle-Answer",
            "type": "shell",
            "command": "${workspaceFolder}/build/totally-not-the-answers/Hello-Triangle/hello-triangle-answer",
            "options": {
                "cwd": "${workspaceFolder}/totally-not-the-answers/Hello-Triangle"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": ["CMake: Build Hello-Triangle-Answer"]
        },
        {
            "label": "CMake: Build Hello-Triangle-Answer-Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--target",
                "hello-triangle-answer-clean",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": ["CMake: Configure Hello-Triangle"]
        },
        {
            "label": "Run: Hello-Triangle-Answer-Clean",
            "type": "shell",
            "command": "${workspaceFolder}/build/totally-not-the-answers/Hello-Triangle-clean/hello-triangle-answer-clean",
            "options": {
                "cwd": "${workspaceFolder}/totally-not-the-answers/Hello-Triangle-clean"
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": [],
            "dependsOn": ["CMake: Build Hello-Triangle-Answer-Clean"]
        }
    ]
}
