{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Hello-Triangle",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Hello-Triangle/hello-triangle",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Hello-Triangle",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build Hello-Triangle",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
